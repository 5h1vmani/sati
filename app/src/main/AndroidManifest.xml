<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission. The app never goes online. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Exact alarms. Android 12 grants SCHEDULE_EXACT_ALARM at install;
         Android 13 and later grant USE_EXACT_ALARM instead. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Android 13 and later ask before showing the sadhana countdown notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Bells ring inside a short foreground service, because Android 17
         mutes sound from apps in the background without one. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

    <!-- Lets the app check that the "unused apps" settings screen exists.
         Android 11 and later hide other apps' screens unless declared here. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.AUTO_REVOKE_PERMISSIONS" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <!-- No backup: a restored "on" setting would come back with no alarm set. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Sati">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A long press on the Quick Settings tile opens this screen. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- directBootAware: after a restart, bells ring before the first unlock.
             Settings and sounds live in device-protected storage for this. -->
        <receiver
            android:name=".BellReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- The test bell from the Bell tab. -->
        <receiver
            android:name=".TestBellReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name=".SadhanaReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- The Pause and Resume buttons on the sadhana notification. -->
        <receiver
            android:name=".SadhanaActionReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Not exported: the system still delivers these broadcasts, and no
             other app can send to it. -->
        <receiver
            android:name=".RescheduleReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- systemExempted is allowed because the app holds USE_EXACT_ALARM
             or SCHEDULE_EXACT_ALARM. directBootAware: bells ring before the
             first unlock, like the receivers above. -->
        <service
            android:name=".BellService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <service
            android:name=".BellTileService"
            android:exported="true"
            android:icon="@drawable/lucide_bell"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
